DATABASE_URL="file:./dev.db"

# Shared password gate (see src/proxy.ts). Set both to enable login;
# leaving either unset keeps every page redirecting to a login form that
# can never succeed, so the app fails closed instead of silently open.
APP_PASSWORD="changeme"
# Generate with: openssl rand -hex 32
SESSION_SECRET="changeme-generate-a-real-random-value"
